---
import "../styles/global.css";
import { localBusinessSchema, websiteSchema } from "../lib/schemas";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  schemas?: object[];
  ogImage?: string;
}

const {
  title = "Neighborhood Hauling and Junk Removal | Riverton, UT",
  description = "Locally owned junk removal and hauling in Utah. Founded by barber Mou. Upfront pricing, hard work, and eco-friendly disposal. Keepin' the hood clean.",
  noindex = false,
  schemas = [],
  ogImage = "/og-default.jpg",
} = Astro.props;

const SITE = "https://neighborhoodhaulingut.com";
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE).toString();
const ogImageUrl = ogImage.startsWith("http") ? ogImage : SITE + ogImage;

const allSchemas = [localBusinessSchema, websiteSchema, ...schemas];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Google tag (gtag.js). GA4 reporting. No Ads conversions on this site. */}
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-WPDT3JQ0VL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WPDT3JQ0VL');
    </script>
    <!-- GA4 conversion events (ga4-contact-events). Mirrors the Umami layer so both
         dashboards agree on what counts as a conversion. Keyed off the href
         SCHEME rather than the data-umami-event attribute, so it still fires on
         a contact link the Umami tagger never reached, and so neither analytics
         layer depends on the other. GA4 event names cannot contain hyphens,
         hence the underscore forms. link_location must be registered as a
         custom dimension in GA4 or it will not appear in reports. -->
    <script is:inline>
      (function () {
        var MAP = { "tel:": "phone_click", "sms:": "text_click", "mailto:": "email_click" };
        document.addEventListener(
          "click",
          function (e) {
            var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
            if (!a) return;
            var href = a.getAttribute("href") || "";
            var name = MAP[href.slice(0, href.indexOf(":") + 1).toLowerCase()];
            /* window.gtag, not a bare gtag: on some layouts the tag is assigned
               rather than declared, and this block may outlive that. */
            if (!name || typeof window.gtag !== "function") return;
            window.gtag("event", name, {
              link_location: a.getAttribute("data-umami-event-location") || "unknown"
            });
          },
          true
        );
      })();
    </script>


    {/* Umami analytics, self-hosted. Reports bounce rate, visit duration and events, which Cloudflare Web Analytics cannot because it is cookieless with no sessions. */}
    <script defer is:inline src="https://analytics.ghost000.com/script.js" data-website-id="eb393471-3454-44ec-8bc4-2351c70ce2a1"></script>

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Neighborhood Hauling" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#0a0a0a" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@400;500;600;700&family=Permanent+Marker&family=UnifrakturCook:wght@700&display=swap"
      rel="stylesheet"
    />

    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <slot name="head" />

    <title>{title}</title>
  </head>
  <!-- The room reserved for the fixed CTA band lives in global.css @layer base rather
       than a pb-* utility here: it needs calc(46px + env(safe-area-inset-bottom)) and
       Tailwind emits no rule for an arbitrary value of that shape. NOTE: this must be
       an HTML comment, not {/* … */} — an Astro expression comment in this position
       (between </head> and <body>) is emitted into the page as literal TEXT, verified
       in dist/. -->
  <body class="bg-brand-black text-white font-mono">
    <slot />

    <!-- Fixed mobile CTA band — form-first primary, call secondary. Hidden on desktop.
         PERMANENTLY SLIMMER, never animated: py-4 around a 24px icon made these 56px
         links and a 58px band, which is a lot of a phone screen to give up for good.
         py-2.5 + min-h-11 pins both links at exactly 44px, so the band is 46px — about
         21% back. 44px is the floor because it is the minimum tappable height, and the
         band must NOT resize or hide on scroll: a tap target that moves while you reach
         for it is a recorded defect in this estate, and a constant slimmer band was the
         explicit choice over an animated one. Nothing in JS touches this element.
         The safe-area padding is new — without it the home indicator sat on the links. -->
    <div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 grid grid-cols-[1fr_auto] gap-px bg-brand-black border-t-2 border-brand-yellow shadow-[0_-8px_24px_rgba(0,0,0,0.4)]" style="padding-bottom: env(safe-area-inset-bottom, 0px);">
      {/* Both icons come from the estate's canonical set and share one wrapper:
          same 18px box, same stroke weight, both stroked rather than one
          stroked and one filled. Strokes are currentColor so each follows its
          own link colour — the quote icon reads black on yellow, the call icon
          yellow on black, from the same markup.

          The quote icon used to be the speech bubble, which across this
          portfolio means SMS. Pointing it at /contact made one shape mean two
          different things depending on the site, so it is now file-text.

          The call link was icon-only while its neighbour was fully labelled,
          which left a bare handset with nothing naming it. It now says "Call".
          That widens the auto column, and "SEND PHOTO · FREE QUOTE" at text-sm
          tracking-widest was already close to the edge of a 320px screen, so
          the type steps down to text-xs below the sm breakpoint. whitespace-
          nowrap is there so that if it ever does run out of room it clips
          rather than wrapping to a second line and growing the whole band. */}
      <a
        href="/contact"
        class="bg-brand-yellow text-brand-black font-mono font-bold text-xs tracking-wider sm:text-sm sm:tracking-widest uppercase whitespace-nowrap flex items-center justify-center gap-2 px-2 py-2.5 min-h-11 hover:bg-brand-yellow/90 transition-colors"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="shrink-0"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Send Photo &middot; Free Quote
      </a>
      <a
        href={`tel:${site.phoneE164}`}
        aria-label={`Call ${site.shortName} at ${site.phoneDisplay}`}
        class="bg-brand-black text-brand-yellow font-mono font-bold text-xs tracking-wider sm:text-sm sm:tracking-widest uppercase whitespace-nowrap flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 min-h-11 hover:bg-brand-yellow/10 transition-colors"
       data-umami-event="cta-call" data-umami-event-location="sticky-bar">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call
      </a>
    </div>

  </body>
</html>
