---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { breadcrumbListSchema } from "../lib/schemas";

const schemas = [
  breadcrumbListSchema([
    { name: "Home", url: "/" },
    { name: "Privacy Policy", url: "/privacy/" },
  ]),
];
---

<Layout
  title="Privacy Policy | Neighborhood Hauling"
  description="How Neighborhood Hauling and Junk Removal collects, uses, and protects your personal information, including SMS opt-in details."
  schemas={schemas}
>
  <Header />
  <main>
    <PageHero
      eyebrow="LEGAL"
      title="Privacy"
      highlight="Policy."
      description="How we collect, use, and protect your information when you request a quote or use our services."
      breadcrumb={[{ label: "Home", href: "/" }, { label: "Privacy Policy", href: "/privacy" }]}
    />

    <section class="bg-white py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 prose-policy text-ink">
        <p class="font-mono text-xs tracking-widest text-ink/60">LAST UPDATED: MAY 1, 2026</p>

        <h2 class="display text-3xl text-brand-black mt-8">Introduction</h2>
        <p class="mt-3 leading-relaxed">
          Welcome to Neighborhood Hauling and Junk Removal. We are committed to safeguarding the privacy of our website visitors and service users. This policy applies where we are acting as a data controller with respect to the personal data of our website visitors and service users; in other words, where we determine the purposes and means of the processing of that personal data.
        </p>

        <h2 class="display text-3xl text-brand-black mt-10">How We Collect Personal Data</h2>
        <p class="mt-3 leading-relaxed">We collect data directly from you when you:</p>
        <ul class="mt-2 space-y-1.5 list-disc pl-6 leading-relaxed">
          <li>Request a quote or book a hauling appointment.</li>
          <li>Purchase our junk removal or hauling services.</li>
          <li>Interact with our website through estimate forms, contact forms, and communication channels.</li>
        </ul>

        <h2 class="display text-3xl text-brand-black mt-10">Data We Collect</h2>
        <p class="mt-3 leading-relaxed">We may collect, store, and use the following kinds of personal information:</p>
        <ul class="mt-2 space-y-1.5 list-disc pl-6 leading-relaxed">
          <li><strong>Device Information:</strong> Details about your computer and visits to our website, including your IP address, geographical location, browser type and version, and operating system.</li>
          <li><strong>Transaction Information:</strong> Information relating to any quotes, transactions, or service appointments made through our website.</li>
          <li><strong>Contact Information:</strong> Information that you provide for the purpose of subscribing to our website services, email notifications, and/or SMS messages.</li>
        </ul>

        <h2 class="display text-3xl text-brand-black mt-10">Use of Personal Data</h2>
        <p class="mt-3 leading-relaxed">The personal data collected is used solely for the purpose of providing you with our hauling and junk removal services. This includes:</p>
        <ul class="mt-2 space-y-1.5 list-disc pl-6 leading-relaxed">
          <li>Administering our website and business operations.</li>
          <li>Personalizing our website experience for you.</li>
          <li>Enabling your use of the services available on our website.</li>
          <li>Supplying hauling and removal services you have requested or purchased.</li>
          <li>Sending service confirmations, arrival reminders, and payment receipts.</li>
        </ul>

        <h2 class="display text-3xl text-brand-black mt-10">Data Retention</h2>
        <p class="mt-3 leading-relaxed">
          We will retain your personal information only for as long as is necessary for the purposes set out in this Privacy Policy. We will retain and use your information to the extent necessary to comply with our legal obligations, resolve disputes, and enforce our policies.
        </p>

        <h2 class="display text-3xl text-brand-black mt-10">Your Rights</h2>
        <p class="mt-3 leading-relaxed">You have the right to:</p>
        <ul class="mt-2 space-y-1.5 list-disc pl-6 leading-relaxed">
          <li>Access the personal data we hold about you.</li>
          <li>Request corrections to any information that is incorrect.</li>
          <li>Request deletion of your personal data.</li>
          <li>Object to the processing of your data, under certain conditions.</li>
          <li>Request the transfer of your data to another organization.</li>
        </ul>

        <h2 class="display text-3xl text-brand-black mt-10">Amendments</h2>
        <p class="mt-3 leading-relaxed">
          We may update this policy from time to time by publishing a new version on our website. You should check this page occasionally to ensure you are happy with any changes to this policy.
        </p>

        <div class="mt-12 bg-brand-yellow border-4 border-brand-black p-6 sm:p-8">
          <h2 class="display text-3xl text-brand-black">SMS Opt-In Details</h2>
          <p class="mt-3 leading-relaxed text-brand-black">
            By providing your phone number, you consent to receive SMS messages from Neighborhood Hauling and Junk Removal related to your quote, scheduling, arrival notifications, and service updates. Message frequency may vary, and message and data rates may apply. You can reply <strong>STOP</strong> at any time to unsubscribe, or reply <strong>HELP</strong> for assistance. Carriers are not liable for delayed or undelivered messages.
          </p>
        </div>

        <div class="mt-6 bg-brand-black border-4 border-brand-yellow p-6 sm:p-8 text-white">
          <h2 class="display text-3xl text-brand-yellow">SMS Data Privacy</h2>
          <p class="mt-3 leading-relaxed">
            We respect your privacy. <strong>No mobile information will be shared with third parties or affiliates for marketing or promotional purposes.</strong> Information sharing to subcontractors in support services, such as customer service, is permitted. All other use cases exclude text messaging originator opt-in data and consent; this information will not be shared with any third parties.
          </p>
        </div>

        <h2 class="display text-3xl text-brand-black mt-12">Cookies &amp; Tracking</h2>
        <p class="mt-3 leading-relaxed">
          We use cookies and similar tracking technologies to enhance user experience, analyze site traffic, and improve our services. You can manage your cookie preferences through your browser settings.
        </p>

        <h2 class="display text-3xl text-brand-black mt-10">Data Security &amp; Handling</h2>
        <p class="mt-3 leading-relaxed">
          We implement appropriate technical and organizational measures to protect your personal information from unauthorized access, misuse, or disclosure. Your data is stored securely and only accessed by authorized personnel.
        </p>

        <h2 class="display text-3xl text-brand-black mt-10">Contact Us</h2>
        <p class="mt-3 leading-relaxed">
          If you have any inquiries about our privacy practices or the information we hold about you, please contact us:
        </p>
        <ul class="mt-2 space-y-1.5 list-none pl-0 leading-relaxed">
          <li>Email: <a href="mailto:team@neighborhoodhaulingut.com" class="underline font-bold text-brand-black" data-umami-event="cta-email" data-umami-event-location="page-body">team@neighborhoodhaulingut.com</a></li>
          <li>Phone: <a href="tel:+18015164149" class="underline font-bold text-brand-black" data-umami-event="cta-call" data-umami-event-location="page-body">(801) 516-4149</a></li>
          <li>Mail: 2081 W 13180 S, Riverton, UT 84065</li>
        </ul>
        <p class="mt-4 leading-relaxed">
          For questions regarding our service policies, please refer to our <a href="/terms" class="underline font-bold text-brand-black">Terms of Service</a>.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .prose-policy { line-height: 1.65; }
  .prose-policy p, .prose-policy li { color: #1a1a1a; }
</style>
