---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Page Not Found | Neighborhood Hauling"
  description="That page took a haul. Head back to the home page or call (801) 516-4149 for a free junk removal quote."
  noindex={true}
>
  <Header />
  <main class="bg-brand-black border-b-4 border-brand-yellow">
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 opacity-[0.08]" style="background-image: repeating-linear-gradient(-45deg, #ffd400 0, #ffd400 2px, transparent 2px, transparent 32px);"></div>

      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-10 py-24 sm:py-32 lg:py-40 relative text-center">
        <div class="display italic text-brand-yellow text-[10rem] sm:text-[14rem] leading-none" style="-webkit-text-stroke:2px #0a0a0a;">404</div>

        <div class="skew-tag bg-brand-yellow text-brand-black mt-2 mx-auto inline-flex">
          <span class="font-mono font-bold text-xs tracking-widest">PAGE HAULED OFF</span>
        </div>

        <h1 class="display text-4xl sm:text-5xl lg:text-6xl text-white mt-6">
          We couldn't find that <span class="text-brand-yellow">page.</span>
        </h1>

        <p class="mt-6 max-w-xl mx-auto text-white/80 text-base sm:text-lg leading-relaxed">
          Looks like the link is broken or the page got cleaned up with the rest of the junk. Try one of these instead.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/" class="btn-skew bg-brand-yellow text-brand-black text-base">
            <span>Back to Home</span>
          </a>
          <a href="/contact" class="btn-skew bg-white text-brand-black text-base">
            <span>Get a Free Quote</span>
          </a>
          <a href="tel:+18015164149" class="btn-skew bg-brand-black text-brand-yellow text-base border-2 border-brand-yellow" data-umami-event="cta-call" data-umami-event-location="cta-band">
            <span>(801) 516-4149</span>
          </a>
        </div>

        <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-xs text-white/60 tracking-widest uppercase">
          <li><a href="/services" class="hover:text-brand-yellow transition-colors">Services</a></li>
          <li><a href="/about" class="hover:text-brand-yellow transition-colors">About Mou</a></li>
          <li><a href="/privacy" class="hover:text-brand-yellow transition-colors">Privacy</a></li>
          <li><a href="/terms" class="hover:text-brand-yellow transition-colors">Terms</a></li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
