---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { breadcrumbListSchema } from "../lib/schemas";

const schemas = [
  breadcrumbListSchema([
    { name: "Home", url: "/" },
    { name: "Contact", url: "/contact/" },
  ]),
];
---

<Layout title="Contact Neighborhood Hauling | Get a Free Junk Removal Quote" description="Send a photo, get a flat trailer-based quote in minutes. Serving Salt Lake, Utah, and Wasatch County. Same-day pickups when our schedule allows. (801) 516-4149." schemas={schemas}>
  <Fragment slot="head">
    <link rel="dns-prefetch" href="//api.leadconnectorhq.com" />
    <link rel="preconnect" href="https://api.leadconnectorhq.com" crossorigin />
    <link rel="dns-prefetch" href="//link.msgsndr.com" />
  </Fragment>
  <Header />
  <main>
    <PageHero
      eyebrow="GET IN TOUCH"
      title="Get a Fast"
      highlight="Free Quote."
      description="Send a photo of what's going, tell us where you are, and we'll have a flat quote back within minutes during business hours. Same-day pickups when our schedule allows."
      breadcrumb={[{ label: "Home", href: "/" }, { label: "Contact", href: "/contact" }]}
    />

    <section class="bg-brand-black py-12 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
        <div class="grid lg:grid-cols-[1.65fr_1fr] gap-10 lg:gap-14 items-start">
          <div class="bg-brand-yellow text-brand-black p-4 sm:p-6 card-shadow relative">
            <div class="absolute -top-5 left-6 skew-tag bg-brand-black text-brand-yellow border-2 border-brand-yellow">
              <span class="display italic text-lg">Send Photos &middot; Free Quote</span>
            </div>

            <div class="mt-3 bg-white border-2 border-brand-black overflow-hidden">
              <iframe
                src="https://api.leadconnectorhq.com/widget/form/ErRRyunhwGfKzdc7VxLR"
                style="width:100%;height:1423px;border:none;display:block;"
                id="inline-ErRRyunhwGfKzdc7VxLR"
                data-layout='{"id":"INLINE"}'
                data-trigger-type="alwaysShow"
                data-trigger-value=""
                data-activation-type="alwaysActivated"
                data-activation-value=""
                data-deactivation-type="neverDeactivate"
                data-deactivation-value=""
                data-form-name="Active Form"
                data-height="1423"
                data-layout-iframe-id="inline-ErRRyunhwGfKzdc7VxLR"
                data-form-id="ErRRyunhwGfKzdc7VxLR"
                title="Get a Free Junk Removal Quote"
              ></iframe>
            </div>
            <script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>
          </div>

          <aside class="space-y-5 lg:sticky lg:top-24">
            <div class="bg-brand-black border-2 border-brand-yellow text-white p-5">
              <div class="font-mono text-[10px] tracking-widest text-brand-yellow">FASTEST PATH</div>
              <p class="display italic text-xl mt-1.5 leading-tight text-white">
                Use the form &mdash; attach a photo or two, and we'll quote you flat.
              </p>
              <p class="font-mono text-xs mt-3 text-white/70 leading-relaxed">
                Most quotes back within minutes during business hours. Same-day pickups when our schedule allows.
              </p>
            </div>

            <a href="tel:+18015164149" class="block bg-white text-brand-black p-5 hover:translate-y-[-3px] transition-transform">
              <div class="font-mono text-[10px] tracking-widest">OR CALL / TEXT</div>
              <div class="display italic text-2xl mt-1">(801) 516-4149</div>
              <div class="font-mono text-xs mt-1.5 text-ink/70">If you'd rather skip the form.</div>
            </a>

            <div class="bg-brand-black border border-white/15 text-white p-5">
              <div class="font-mono text-[10px] tracking-widest text-brand-yellow">BASED IN</div>
              <div class="display italic text-2xl mt-1.5 leading-tight">Riverton, Utah</div>
              <div class="font-mono text-[11px] mt-2 text-white/60 leading-relaxed">
                Trucks roll out daily across Salt Lake, Utah, and Wasatch County.
              </div>
            </div>

            <div class="bg-brand-black border border-white/15 text-white p-5">
              <div class="font-mono text-[10px] tracking-widest text-brand-yellow">HOURS</div>
              <ul class="font-mono text-sm mt-2 space-y-1">
                <li class="flex justify-between"><span>Mon &ndash; Fri</span><span>7a &ndash; 7p</span></li>
                <li class="flex justify-between"><span>Saturday</span><span>8a &ndash; 5p</span></li>
                <li class="flex justify-between"><span>Sunday</span><span class="text-white/50">By appointment</span></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div>
            <h2 class="display text-4xl sm:text-5xl text-brand-black">
              We Serve <span class="text-brand-yellow" style="-webkit-text-stroke:2px #0a0a0a;">Salt Lake & Utah County.</span>
            </h2>
            <p class="mt-5 text-ink/75 leading-relaxed">
              Based in Riverton, our trucks roll out daily across the Wasatch Front. Bluffdale, Riverton, Herriman, South Jordan, West Jordan, Sandy, Draper, Lehi, Saratoga Springs, American Fork, Provo, Orem, Salt Lake City, and everywhere in between.
            </p>
          </div>
          <div class="aspect-video bg-brand-black border-4 border-brand-yellow card-shadow relative overflow-hidden flex items-center justify-center">
            <div class="text-center">
              <svg viewBox="0 0 24 24" class="w-16 h-16 mx-auto text-brand-yellow/40" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>
              <div class="mt-3 font-mono text-[10px] text-brand-yellow/60 tracking-widest">[ optional: embed Google Maps here ]</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
