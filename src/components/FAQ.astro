---
import { faqs } from "../data/faq";
---

<section id="faq" class="bg-white py-20 lg:py-28 relative">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-10">
    <div class="text-center mb-12">
      <div class="skew-tag bg-brand-black text-brand-yellow border-2 border-brand-yellow mb-5 inline-flex">
        <span class="font-mono font-bold text-xs tracking-widest">FAQ</span>
      </div>
      <h2 class="display text-5xl sm:text-6xl text-brand-black">
        Quick <span class="text-brand-yellow" style="-webkit-text-stroke:2px #0a0a0a;">Answers.</span>
      </h2>
      <p class="mt-5 text-ink/70 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
        Got a question? It might already be down here. If not, send a photo through the form and we'll answer it personally.
      </p>
    </div>

    <ul class="divide-y-2 divide-brand-black/10 border-y-2 border-brand-black/10">
      {faqs.map((f, i) => (
        <li>
          <details class="group">
            <summary class="cursor-pointer list-none py-5 flex items-center justify-between gap-4 hover:bg-brand-yellow/5 transition-colors px-2 -mx-2">
              <span class="font-mono text-[10px] tracking-widest text-brand-yellow w-7 shrink-0">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="display italic text-xl sm:text-2xl text-brand-black flex-1 leading-tight">{f.q}</span>
              <span class="size-8 shrink-0 flex items-center justify-center bg-brand-black text-brand-yellow group-open:bg-brand-yellow group-open:text-brand-black transition-colors">
                <svg viewBox="0 0 24 24" class="w-4 h-4 group-open:rotate-45 transition-transform" fill="currentColor" aria-hidden="true">
                  <path d="M11 5h2v14h-2zM5 11h14v2H5z"/>
                </svg>
              </span>
            </summary>
            <p class="px-9 pb-6 text-ink/85 text-base leading-relaxed">
              {f.a}
            </p>
          </details>
        </li>
      ))}
    </ul>

    <div class="mt-12 text-center">
      <a href="/contact" class="btn-skew bg-brand-black text-brand-yellow text-base">
        <span>Still Have Questions? Send a Photo &middot; Free Quote</span>
      </a>
    </div>
  </div>
</section>
