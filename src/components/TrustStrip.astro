---
const items = [
  { label: "Fully Licensed & Insured", icon: "shield" },
  { label: "Same-Day Quotes", icon: "bolt" },
  { label: "Flat-Rate Pricing", icon: "tag" },
  { label: "Eco-Friendly Disposal", icon: "leaf" },
];
---

<section aria-label="Why choose Neighborhood Hauling" class="bg-brand-yellow border-y-4 border-brand-black">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-5">
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-brand-black">
      {items.map((it, i) => (
        <li class="flex items-center gap-2.5">
          {it.icon === "shield" && (
            <svg viewBox="0 0 24 24" class="w-5 h-5 shrink-0" fill="currentColor" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.4 9.5-8 10-4.6-.5-8-5-8-10V6l8-4zm0 5l-4 2v3c0 3 1.7 5.7 4 6.3 2.3-.6 4-3.3 4-6.3V9l-4-2z"/></svg>
          )}
          {it.icon === "bolt" && (
            <svg viewBox="0 0 24 24" class="w-5 h-5 shrink-0" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
          )}
          {it.icon === "tag" && (
            <svg viewBox="0 0 24 24" class="w-5 h-5 shrink-0" fill="currentColor" aria-hidden="true"><path d="M21 11l-9-9H4v8l9 9 8-8zM7 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>
          )}
          {it.icon === "leaf" && (
            <svg viewBox="0 0 24 24" class="w-5 h-5 shrink-0" fill="currentColor" aria-hidden="true"><path d="M17 4c-7 0-11 4-11 11 0 2 .5 4 1.5 5.5L8 21l1.5-1c1.5 1 3.5 1 5.5 1 7 0 8-7 8-12V4h-6z"/></svg>
          )}
          <span class="font-mono font-bold text-sm tracking-wide">{it.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
