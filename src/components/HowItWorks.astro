---
const steps = [
  {
    n: "01",
    title: "Send a Picture",
    body: "Snap a photo of what needs to go and send it through our form. Tell us where you are and we'll do the rest.",
  },
  {
    n: "02",
    title: "Get a Free Quote & Pickup Time",
    body: "We send back a flat quote and a pickup window during business hours. No on-site sales pitch, no estimates that move.",
  },
  {
    n: "03",
    title: "We Haul It Away",
    body: "We show up, load it up, and sweep up after. You get your space back &mdash; and we sort, recycle, and donate whatever we can.",
  },
];
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <div class="text-center mb-14">
      <div class="skew-tag bg-brand-black text-brand-yellow mb-5">
        <span class="font-mono font-bold text-xs tracking-widest">HOW IT WORKS</span>
      </div>
      <h2 class="display text-5xl sm:text-6xl text-brand-black">
        Three Steps. <span class="text-brand-yellow" style="-webkit-text-stroke:2px #0a0a0a;">Done.</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {steps.map((s, i) => (
        <div class="relative bg-white border-2 border-brand-black p-8 card-shadow">
          <div class="absolute -top-5 left-6 skew-tag bg-brand-yellow text-brand-black">
            <span class="display italic text-xl">STEP {s.n}</span>
          </div>
          <h3 class="display italic text-3xl text-brand-black mt-4 mb-4" set:html={s.title}></h3>
          <p class="text-ink/80 text-sm leading-relaxed" set:html={s.body}></p>
          {i === 0 && (
            <a href="/contact" class="btn-skew bg-brand-black text-brand-yellow text-sm mt-6">
              <span>Send Your Photo</span>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
