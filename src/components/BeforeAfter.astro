---
import { cfImageUrl, cfImageSrcset } from "../lib/cfImage";

const pairs = [
  { id: "job1", before: "jobs/job1-before.jpg", after: "jobs/job1-after.jpg", label: "Side-yard pickup" },
  { id: "job2", before: "jobs/job2-before.jpg", after: "jobs/job2-after.jpg", label: "Brick & paver haul" },
  { id: "job5", before: "jobs/job5-before.jpg", after: "jobs/job5-after.jpg", label: "Yard pile cleanout" },
  { id: "job7", before: "jobs/job7-before.jpg", after: "jobs/job7-after.jpg", label: "Pallets & landscape bags" },
  { id: "job9", before: "jobs/job9-before.jpg", after: "jobs/job9-after.jpg", label: "Playset teardown" },
  { id: "job10", before: "jobs/job10-before.jpg", after: "jobs/job10-after.jpg", label: "Move-out cleanup" },
];

const cardSizes = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw";
---

<section id="proof" class="bg-white py-20 lg:py-28 relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="skew-tag bg-brand-black text-brand-yellow mb-5 inline-flex">
        <span class="font-mono font-bold text-xs tracking-widest">REAL JOBS &middot; REAL TRUCKS</span>
      </div>
      <h2 class="display text-5xl sm:text-6xl lg:text-7xl text-brand-black">
        From Chaos. <span class="text-brand-yellow" style="-webkit-text-stroke:2px #0a0a0a;">To Clear.</span>
      </h2>
      <p class="mt-6 text-ink/80 text-base sm:text-lg leading-relaxed">
        Tap any photo to flip from <strong>before</strong> to <strong>after</strong>. Every one of these is one of Mou's actual jobs &mdash; no stock photos, no exaggeration.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {pairs.map((p) => (
        <button
          type="button"
          class="ba-card group relative aspect-[4/3] overflow-hidden border-4 border-brand-black card-shadow bg-brand-black focus:outline-none focus:ring-4 focus:ring-brand-yellow"
          data-ba
          aria-label={`${p.label}: tap to toggle before and after`}
        >
          <div class="ba-before absolute inset-0 transition-opacity duration-300">
            <img
              src={cfImageUrl(p.before, 'card')}
              srcset={cfImageSrcset(p.before)}
              alt={`${p.label} — before`}
              sizes={cardSizes}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute top-3 left-3 bg-brand-black text-brand-yellow font-marker text-2xl px-4 py-1 leading-none">Before</div>
          </div>

          <div class="ba-after absolute inset-0 opacity-0 transition-opacity duration-300">
            <img
              src={cfImageUrl(p.after, 'card')}
              srcset={cfImageSrcset(p.after)}
              alt={`${p.label} — after`}
              sizes={cardSizes}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute top-3 left-3 bg-brand-yellow text-brand-black font-marker text-2xl px-4 py-1 leading-none">After</div>
          </div>

          <div class="absolute bottom-3 right-3 bg-brand-yellow text-brand-black font-mono text-[10px] font-bold tracking-widest px-3 py-1.5 shadow-md flex items-center gap-1.5">
            <svg viewBox="0 0 24 24" class="w-3 h-3" fill="currentColor" aria-hidden="true"><path d="M12 4V1L8 5l4 4V6c3.3 0 6 2.7 6 6 0 1-.2 1.9-.7 2.7l1.5 1.5C19.5 15 20 13.6 20 12c0-4.4-3.6-8-8-8zM6 12c0-1 .2-1.9.7-2.7L5.2 7.8C4.5 9 4 10.4 4 12c0 4.4 3.6 8 8 8v3l4-4-4-4v3c-3.3 0-6-2.7-6-6z"/></svg>
            TAP TO FLIP
          </div>
          <div class="absolute bottom-3 left-3 bg-brand-black text-white font-mono text-[10px] tracking-widest px-3 py-1.5 border border-brand-yellow/40">
            {p.label.toUpperCase()}
          </div>
        </button>
      ))}
    </div>

    <div class="mt-14 text-center">
      <a href="/contact" class="btn-skew bg-brand-black text-brand-yellow text-base">
        <span>Send Your Photo &middot; Get a Quote</span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* Default: BEFORE shown, AFTER hidden. Click toggles state both directions.
     Global so the same flip rule applies to BeforeAfter cards AND FeatureHero. */
  .ba-card[data-ba-state="after"] .ba-before { opacity: 0; }
  .ba-card[data-ba-state="after"] .ba-after { opacity: 1; }
  /* No hover-flip: sticky :hover on touch devices was locking cards in AFTER state. */
</style>

<script>
  // Tap toggles before/after. Selects every [data-ba] on the page, so this
  // single handler covers both the BeforeAfter cards and the FeatureHero card.
  const cards = document.querySelectorAll<HTMLButtonElement>("[data-ba]");
  cards.forEach((card) => {
    card.addEventListener("click", () => {
      card.dataset.baState = card.dataset.baState === "after" ? "before" : "after";
    });
  });
</script>
