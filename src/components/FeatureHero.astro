---
import { cfImageUrl, cfImageSrcset } from "../lib/cfImage";

const featureBefore = "jobs/job5-before.jpg";
const featureAfter = "jobs/job5-after.jpg";
const heroSizes = "(min-width: 1024px) 50vw, 100vw";
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="relative">
        <button
          type="button"
          class="ba-card group block w-full aspect-[4/3] bg-brand-black border-4 border-brand-yellow card-shadow overflow-hidden relative focus:outline-none focus:ring-4 focus:ring-brand-black"
          data-ba
          aria-label="Hero job: tap to toggle before and after"
        >
          <div class="ba-before absolute inset-0 transition-opacity duration-300">
            <img
              src={cfImageUrl(featureBefore, 'card')}
              srcset={cfImageSrcset(featureBefore)}
              alt="Before the haul — dried tree branches, pallets, and old yard equipment piled against the side of a house"
              sizes={heroSizes}
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <div class="absolute top-3 left-3 bg-brand-black text-brand-yellow font-marker text-3xl px-4 py-1 leading-none">Before</div>
          </div>

          <div class="ba-after absolute inset-0 opacity-0 transition-opacity duration-300">
            <img
              src={cfImageUrl(featureAfter, 'card')}
              srcset={cfImageSrcset(featureAfter)}
              alt="After the haul — the same concrete patio swept clean"
              sizes={heroSizes}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute top-3 left-3 bg-brand-yellow text-brand-black font-marker text-3xl px-4 py-1 leading-none">After</div>
          </div>

          <div class="absolute bottom-3 right-3 bg-brand-yellow text-brand-black font-mono text-[11px] font-bold tracking-widest px-3 py-1.5 shadow-md flex items-center gap-1.5">
            <svg viewBox="0 0 24 24" class="w-3 h-3" fill="currentColor" aria-hidden="true"><path d="M12 4V1L8 5l4 4V6c3.3 0 6 2.7 6 6 0 1-.2 1.9-.7 2.7l1.5 1.5C19.5 15 20 13.6 20 12c0-4.4-3.6-8-8-8zM6 12c0-1 .2-1.9.7-2.7L5.2 7.8C4.5 9 4 10.4 4 12c0 4.4 3.6 8 8 8v3l4-4-4-4v3c-3.3 0-6-2.7-6-6z"/></svg>
            TAP TO FLIP
          </div>
        </button>
        <div class="absolute -top-4 -left-4 skew-tag bg-brand-black text-brand-yellow pointer-events-none">
          <span class="font-mono font-bold text-xs tracking-widest">UTAH STRONG</span>
        </div>
      </div>

      <div>
        <h2 class="display text-5xl sm:text-6xl lg:text-7xl text-brand-black">
          Tough Jobs.<br />
          <span class="text-brand-yellow" style="-webkit-text-stroke:2px #0a0a0a;">Clean Results.</span>
        </h2>
        <p class="mt-8 text-ink/80 text-lg leading-relaxed max-w-xl">
          Don't look anywhere else. You found the best in the business. Local, insured, and on time, every time. We show up ready to lift, sort, and sweep up after.
        </p>
        <div class="mt-10 flex flex-wrap gap-5">
          <a href="/contact" class="btn-skew bg-brand-black text-brand-yellow text-base">
            <span>Send Photos &middot; Free Quote</span>
          </a>
          <a href="tel:+18015164149" class="btn-skew border-2 border-brand-black text-brand-black text-base" data-umami-event="cta-call" data-umami-event-location="hero">
            <span>Or Call (801) 516-4149</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
