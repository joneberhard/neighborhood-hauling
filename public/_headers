# Cloudflare Pages reads this file at deploy time. See:
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Per site-build-playbook.md "HTTP security headers" — every site gets these.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Long-cache hashed assets generated by Astro
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Long-cache logos in /public/ (versioned by filename when updated)
/logo-white.webp
  Cache-Control: public, max-age=31536000, immutable
/logo-color.jpg
  Cache-Control: public, max-age=31536000, immutable
# Favicon: short cache (NOT immutable) — it lives at a stable filename but its
# contents do change. Immutable here strands the old icon for a year (it did).
# Bump the ?v= query in Layout.astro when the icon changes to break edge cache.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
